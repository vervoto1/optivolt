#!/usr/bin/with-contenv bashio
set -euo pipefail

APP_DIR="/opt/optivolt"

export HOST="0.0.0.0"
export PORT="3000"      # matches ingress_port
export DATA_DIR="/data" # HA persistent storage

# Read add-on options (from config.yaml)
SITE_ID="$(bashio::config 'site_id')"
TOKEN="$(bashio::config 'vrm_token')"

# Export for the Node process
export VRM_INSTALLATION_ID="${SITE_ID}"
export VRM_TOKEN="${TOKEN}"

export MQTT_HOST="$(bashio::config 'mqtt_host')"
export MQTT_PORT="$(bashio::config 'mqtt_port')"
export MQTT_USERNAME="$(bashio::config 'mqtt_username')"
export MQTT_PASSWORD="$(bashio::config 'mqtt_password')"
export MQTT_TLS="$(bashio::config 'mqtt_tls')"
export MQTT_TLS_INSECURE="$(bashio::config 'mqtt_tls_insecure')"

if [ -z "${VRM_INSTALLATION_ID}" ] || [ -z "${VRM_TOKEN}" ]; then
  bashio::log.warning "VRM credentials not set. VRM endpoints will return 400 (Bad Request) until configured."
fi

# The server is TypeScript run by Node's built-in type stripping. A Node built
# without it (Alpine's Node 22 was compiled --without-amaro) cannot even parse
# api/index.ts; say so plainly instead of failing on a cryptic import error.
# A version check is not enough: the feature flag is what matters.
if ! node -e "process.exit(process.features.typescript ? 0 : 1)"; then
  bashio::log.fatal "Node.js $(node --version) was built without TypeScript type stripping (process.features.typescript is off); OptiVolt cannot start on this base image."
  exit 1
fi

cd "$APP_DIR"
# exec: node is the supervised process, so SIGTERM reaches the shutdown handler
# directly (no launcher in between that could SIGKILL it mid-solve).
exec node "$APP_DIR/api/index.ts"
