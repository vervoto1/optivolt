{
  "name": "optivolt",
  "version": "0.7.66",
  "description": "Optivolt is a linear and mixed-integer optimizer for home energy systems.",
  "homepage": "https://github.com/bmesuere/optivolt#readme",
  "bugs": {
    "url": "https://github.com/bmesuere/optivolt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmesuere/optivolt.git"
  },
  "license": "MIT",
  "author": "Bart Mesuere",
  "type": "module",
  "main": "api/index.ts",
  "scripts": {
    "api": "node ./api/index.ts",
    "dev": "dotenv -e .env.local -- nodemon --exec node --ignore 'data/' ./api/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "npx eslint .",
    "build:css": "tailwindcss -i tailwind.source.css -o app/vendor/tailwind.css --minify"
  },
  "engines": {
    "node": "^22.18.0 || >=24"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "mqtt-packet": "^9.0.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "^2.6.0"
    },
    "micromark-extension-math": {
      "katex": "^0.18.11"
    },
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
